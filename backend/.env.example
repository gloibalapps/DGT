# Drivers Gig Tax backend (FastAPI). Copy to backend/.env for local dev;
# in production set these on the backend host (Render dashboard > Environment).

# --- Database: Supabase Postgres (Dashboard > Connect > "Session pooler" or
# "Transaction pooler" URI). SECRET.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- AI (Anthropic, console.anthropic.com > API keys). SECRET.
ANTHROPIC_API_KEY=
# optional overrides (public)
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VISION_MODEL=claude-sonnet-4-6

# --- Google OAuth web client (Google Cloud Console > APIs & Services > Credentials).
# Authorised redirect URI must be  https://<backend-host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Apple: comma-separated allowed audiences (iOS bundle id, and
# Services ID if used for web). Public.
APPLE_AUDIENCES=com.driversgigtax.app

# --- Fernet key for Google Drive tokens at rest. SECRET. MUST be the same value
# as the current production key or existing Drive connections can't be decrypted.
# New key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DRIVE_ENCRYPTION_KEY=

# --- Optional: comma-separated CORS origins (default *)
CORS_ORIGINS=*

# --- Google sign-in return URLs. driversgigtax:// is always allowed.
# Comma-separated https origins (scheme + host, no path). Anything else is rejected.
# Example: https://driversgigtax.app
OAUTH_REDIRECT_ORIGINS=https://driversgigtax.app

# --- 14-day free trial + server-side paywall (backend/subscription.py)
# Leave false until RevenueCat products are live AND the app was built with
# real EXPO_PUBLIC_RC_IOS_KEY / EXPO_PUBLIC_RC_ANDROID_KEY (not the test key).
# Then set this to true. See docs/DEPLOY_CHECKLIST.md.
PAYWALL_ENFORCED=false
TRIAL_DAYS=14
# Accounts created before the trial feature (no trial_started_at) start their
# 14 days at max(created_at, this). ISO date/datetime (UTC). Empty = the moment
# the server first sees them after deploy (i.e. cutover day).
TRIAL_EXISTING_USERS_START=
# Demo accounts (App Store / Play review). Off unless both of these are set.
# The app sends the secret as X-Demo-Review-Secret (review builds only).
DEMO_ENABLED=false
DEMO_REVIEW_SECRET=
# When true, demo accounts skip the paywall. They still cannot call
# /api/ask or /api/receipts/scan. Default false.
DEMO_ENTITLED=false
# Optional per-minute caps (demo is per IP, AI routes are per user).
DEMO_RATE_LIMIT=5
AI_RATE_LIMIT=30
# RevenueCat secret API key (Project > API keys > Secret, sk_...). SECRET, server only.
REVENUECAT_SECRET_API_KEY=
RC_ENTITLEMENT_ID=pro
RC_CACHE_TTL_SECONDS=300
# Keep a previously-active subscriber active this long if RevenueCat is unreachable
RC_GRACE_HOURS=24
# Exact Authorization header value set in RevenueCat > Integrations > Webhooks. SECRET.
# Webhook URL: https://<backend-host>/api/subscription/webhook
REVENUECAT_WEBHOOK_AUTH=
