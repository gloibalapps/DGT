# Expo app. EXPO_PUBLIC_* values are inlined into the JS bundle at build time,
# so they are PUBLIC by definition (never put a server secret here).
# Local: copy to frontend/.env. EAS builds: set per profile in eas.json "env"
# or as EAS environment variables (expo.dev > project > Environment variables).

# FastAPI backend base URL (no trailing slash, no /api)
EXPO_PUBLIC_BACKEND_URL=https://api.driversgigtax.app

# RevenueCat public SDK keys (app.revenuecat.com > Project > API keys)
EXPO_PUBLIC_RC_IOS_KEY=appl_xxx
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxx
# Test Store key. Used only in dev builds when the real store key above is empty.
# A release build ignores this and ignores a test_ value in the store-key vars.
EXPO_PUBLIC_RC_TEST_KEY=
# Review builds only. Must match the backend DEMO_REVIEW_SECRET. Leave empty otherwise.
EXPO_PUBLIC_DEMO_REVIEW_SECRET=
# Entitlement id; must match RevenueCat and the backend's RC_ENTITLEMENT_ID
EXPO_PUBLIC_RC_ENTITLEMENT_ID=pro
