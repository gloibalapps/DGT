{
  "expo": {
    "name": "GigTax",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.earningsauditapp.cxv7id",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan receipts to log deductible expenses",
        "NSPhotoLibraryUsageDescription": "Pick receipt photos to log expenses",
        "NSLocationWhenInUseUsageDescription": "Track business drives for your logbook",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track drives automatically in the background",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A1420"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.earningsauditapp.cxv7id",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A1420"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Track business drives for your logbook",
          "locationAlwaysAndWhenInUsePermission": "Track drives automatically in the background",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick receipt photos to log expenses",
          "cameraPermission": "Scan receipts to log deductible expenses"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan receipts to log deductible expenses"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
